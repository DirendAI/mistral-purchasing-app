{
  "schemaVersion": 2,
  "kind": "app",
  "name": "mistral-purchasing-app",
  "deployment": {
    "organizationId": "00e7b3cd-bb2f-497e-a4b4-54c166b945bc",
    "workspaceId": "5a8253fa-f652-4182-a52e-11c8c51dbece",
    "appId": "01a1a7a4-683a-75ff-8f44-1a697a752c7a"
  },
  "modules": [
    {
      "type": "app",
      "name": "api",
      "path": "apps/api",
      "routes": [
        {
          "path": "/api"
        }
      ],
      "port": 3000,
      "serve": "server",
      "runtime": "python",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.api",
        "target": "api"
      },
      "dev": {
        "startCommand": "uv run --all-packages python -m api.dev",
        "preStartCommands": [
          "uv run --all-packages python -m cli pre-start"
        ]
      },
      "deploy": {
        "startCommand": "uv run --frozen --no-dev --no-sync uvicorn api.main:app --host \"$HOST\" --port \"$PORT\" --proxy-headers --timeout-graceful-shutdown 20",
        "preStartCommands": [
          "uv run --frozen --no-dev --no-sync python -m cli pre-start"
        ]
      }
    },
    {
      "type": "app",
      "name": "worker",
      "path": "apps/worker",
      "routes": [],
      "port": null,
      "serve": "worker",
      "runtime": "python",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.worker"
      },
      "platform": "workflows",
      "dev": {
        "startCommand": "bash ../../tools/uv.sh run --all-packages python -m worker.entrypoints.dev"
      }
    },
    {
      "type": "app",
      "name": "web",
      "path": "apps/web",
      "routes": [
        {
          "path": "/"
        }
      ],
      "port": 3001,
      "serve": "static",
      "runtime": "node",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.web",
        "target": "runtime"
      },
      "dev": {
        "startCommand": "bun run dev"
      },
      "deploy": {
        "startCommand": "node .output/server/index.mjs"
      }
    },
    {
      "type": "app",
      "name": "agent",
      "path": "apps/agent",
      "routes": [],
      "port": null,
      "serve": "worker",
      "runtime": "python",
      "platform": "agents",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.agent"
      },
      "dev": {
        "startCommand": "bash ../../tools/uv.sh run --all-packages --directory apps/agent agents serve"
      }
    },
    {
      "type": "managed",
      "name": "postgres",
      "engine": "postgres"
    }
  ]
}
